{
    "batch_size": 1,
    "accum_steps": 36,
    "num_epochs": 1,
    "num_epochs_dataset_specific": [ { "offsetbias_dpo": 1.5 }, { "openhermes_misconception_dpo": 1 }, { "truthfulqa_dpo": 1.5 }, { "truthy_dpo": 1.5 }, { "metamath_dpo": 1 } ],
    "recompute_lmhead": true,
