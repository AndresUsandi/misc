{
    "batch_size": 32,
    "accum_steps": 8,
    "num_epochs": 1,
    "num_epochs_dataset_specific": [ { "smol_smoltalk": 2 }, { "dolly": 2 }, { "everyday_conversations": 2 }, { "no_robots": 2 }, { "oasst2": 2 }, { "capybara": 2 }, { "opus_writingprompts": 2 }, { "smoltalk_magpie_ultra": 1 }, { "ultrachat_200k": 0.5 }, { "gsm8k": 3 }, { "metamath_qa": 3 } ],
    "chunk_size": 4096,
    "recompute_lmhead": false,
    "single_gpu": false,
    "gpu_index": 0,
    "multi_gpu_strategy": "data-parallelism",
    "compile": true,
    "precision": "fp8",
    "warmup_ratio": 0.03,
    "learning_rate": 0.0001,
    "min_lr": 0.00001,
