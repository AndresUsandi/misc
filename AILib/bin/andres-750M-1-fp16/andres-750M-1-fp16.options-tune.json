{
    "batch_size": 8,
    "accum_steps": 16,
    "num_epochs": 2,
    "chunk_size": 1024,
    "recompute_lmhead": false,
    "single_gpu": false,
    "gpu_index": 0,
    "multi_gpu_strategy": "data-parallelism",
    "compile": true,
    "precision": "fp16",
    "use_muon": true,
    "muon_lr": 0.0005,
    "warmup_ratio": 0.03,
    "learning_rate": 0.00005,
    "min_lr": 0.000005,
    "weight_decay": 0.01,
    "eval_freq": 50,
    "eval_iter": 20,
    "save_interval": 200,
    "max_length": 2048,
    "pad_to_multiple_of": 128,
    "activation_checkpointing": true,
    "precompute_total_steps": true
}